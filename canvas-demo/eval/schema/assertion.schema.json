{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canvas-demo:render-eval-assertion:v1",
  "title": "Canvas render evaluation assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assertion_id", "case_id", "subject", "oracle", "name", "required", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "assertion_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
    "subject": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["capture_id"], "properties": { "capture_id": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["action_id"], "properties": { "action_id": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["case_id"], "properties": { "case_id": { "type": "string" } } }
      ]
    },
    "oracle": { "enum": ["trajectory", "model", "dom", "accessibility", "console", "layout", "iframe", "visual-regression", "visual-quality"] },
    "name": { "type": "string", "minLength": 1 },
    "required": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "skip"] },
    "actual": {},
    "expected": {},
    "threshold": {},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "media_type"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "message": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "skip" } }, "required": ["status"] },
      "then": { "required": ["message"] }
    }
  ]
}

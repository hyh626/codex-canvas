{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canvas-demo:model:v1",
  "title": "Canvas card model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body", "color"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
          "title": { "type": "string", "maxLength": 120 },
          "body": { "type": "string", "maxLength": 2000 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    }
  },
  "$comment": "The runtime additionally enforces unique component IDs and optimistic baseRevision. String lengths in runtime are UTF-16 code units, slightly stricter for astral characters. Schema version is carried by the surrounding event envelope."
}
